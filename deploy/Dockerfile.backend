# ════════════════════════════════════════════════════════════
# 凌瑶智数 · 后端镜像构建文件（Dockerfile.backend）
# ────────────────────────────────────────────────────────────
# 与 backend/docker/Dockerfile.cn 的关键差异：
#   ✗ 旧版用 eclipse-temurin:17（不符合 V2.0.11+ JDK 21 铁律）
#   ✓ 本版用 eclipse-temurin:21（与 CVM 部署 openjdk-21-jdk-headless 对齐）
#
# 构建：
#   docker build -f deploy/Dockerfile.backend -t lingyao/platform:2.0.14 .
#
# 由 docker-compose.yml 引用，无需手动 build
# ════════════════════════════════════════════════════════════

# ─── 阶段 1：构建 ──────────────────────────────────
# 本地 dev 默认走 DaoCloud 加速器（主人本机 daemon.json 无 mirror，但之前 postgres 镜像就是从 DaoCloud 拉的）
# 云端 prod：如 CVM 可直连 docker.io，请改回 FROM maven:3.9-eclipse-temurin-21
FROM m.daocloud.io/docker.io/library/maven:3.9-eclipse-temurin-21 AS builder
# WORKDIR 必须设到 /build/backend，让 mvn 在正确目录跑，jar 才会打到 /build/backend/target/
WORKDIR /build/backend

# 先复制 pom.xml 利用 Docker 层缓存加速依赖下载
COPY backend/pom.xml ./
RUN mvn -q dependency:go-offline -DskipTests 2>/dev/null || true

# 再复制源码并打包
COPY backend/src src
RUN mvn -q -DskipTests package

# ─── 阶段 2：运行时镜像 ──────────────────────────────
# 同上：本地 dev 默认走 DaoCloud，云端可改回 FROM eclipse-temurin:21-jre
FROM m.daocloud.io/docker.io/library/eclipse-temurin:21-jre
WORKDIR /app

# 安装运行时依赖：curl（健康检查）+ tzdata（时区）+ openssl（JWT secret 生成）+ zip（备份）
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl tzdata ca-certificates openssl zip \
    && rm -rf /var/lib/apt/lists/*

# 强制时区为东八区（与 application-private.yml jdbc.time_zone=Asia/Shanghai 对齐）
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 复制构建产物 + entrypoint + 备份脚本
COPY --from=builder /build/backend/target/lingyao-platform.jar /app/lingyao-platform.jar
COPY backend/docker/entrypoint.sh /app/entrypoint.sh
COPY backend/docker/backup.sh     /app/backup.sh
RUN chmod +x /app/entrypoint.sh /app/backup.sh

# 持久化目录（JWT secret / DB 数据 / 日志）
RUN mkdir -p /app/data /app/logs /app/backup

EXPOSE 9091

# JVM 参数 + Spring profile（与 backend/docker/Dockerfile.cn 完全一致）
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom"
ENV SPRING_PROFILES_ACTIVE=private

# 健康检查（与 docker-compose.yml 健康检查一致，作为镜像层兜底）
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:9091/api/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]