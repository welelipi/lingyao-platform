# ════════════════════════════════════════════════════════════
# 凌瑶智数 · 环境变量模板（.env.example → .env）
# ────────────────────────────────────────────────────────────
# 用法：
#   cp .env.example .env
#   vi .env   # 填真实值
#   docker compose up -d
#
# ⚠️ 安全铁律：
#   - .env 文件已加入 .gitignore，禁止 commit
#   - 真值只能放在 .env 或云端密钥管理服务（如腾讯云 SecretsManager）
#   - 任何写到 git 的 .env 必须立即 rotate 所有相关密钥
#
# ⚠️ 两端一致性铁律（2026-08-30 09:12 主人下达）：
#   - 本地 dev 的 .env 与 云端 prod 的 .env 必须保持字段一致
#   - 仅「值」可不同（密码可以不同）
#   - 字段缺失 / 多余 = 配置漂移 = 推送后不一致
# ════════════════════════════════════════════════════════════

# ─── PostgreSQL 配置 ────────────────────────────────
# 数据库名（dev = lingyao，staging = lingyao_staging，prod = lingyao）
POSTGRES_DB=lingyao
# 用户名（与 backend/src/main/resources/application-private.yml 一致）
POSTGRES_USER=lingyao_app
# 密码 ⚠️ 必须强密码：12+ 位、大小写+数字+特殊字符、不含用户名
# 本地推荐：LingYao@Dev_2026_Pg!（仅本地调试用）
# 云端由云端主流程生成，主人认可后写入云端 .env
POSTGRES_PASSWORD=__REPLACE_ME_WITH_STRONG_PASSWORD__

# 端口映射（本地 5432 默认；云端请勿对外暴露 5432）
POSTGRES_PORT=5432
# 绑定地址（本地默认 127.0.0.1 仅本机；云端改 0.0.0.0 允许 backend 容器访问）
POSTGRES_BIND=127.0.0.1

# ─── Spring Boot Backend 配置 ───────────────────────
# Profile（dev 用 dev+本地 h2；容器一律用 private）
SPRING_PROFILES_ACTIVE=private

# 后端端口
BACKEND_PORT=9091
# 绑定地址（本地默认 127.0.0.1；云端改 0.0.0.0 允许 nginx 反代访问）
BACKEND_BIND=127.0.0.1

# ─── JWT 密钥（铁律级） ─────────────────────────────
# 留空 = 由 entrypoint.sh 首次启动时自动生成 64 字节密钥并持久化到 /app/data/.jwt_secret
# 显式填值 = 跨环境统一密钥（适用于跨域 SSO 场景）
#
# ⚠️ 本地 dev 与云端 prod 是否要同一密钥？
#   - 同密钥：本地 SSO 测试可走完整链路（推荐）
#   - 不同密钥：本地测试独立、生产独立（更安全，但本地不能验证 SSO token 跨域行为）
#
# 当前建议：本地与云端共用同一密钥（从云端 .env 复制过来），便于本地复现 SSO 问题
LINGYAO_JWT_SECRET=

# ─── 版本元数据（注入 /api/version 端点） ─────────────
# 与 backend/src/main/resources/application.yml app.version 同步
APP_VERSION=2.0.14
# Git commit hash（CI 自动注入；本地手动填 "local"）
APP_GIT_COMMIT=local
# 构建时间（CI 自动注入 ISO 8601；本地手动填空）
APP_BUILD_TIME=
# 发布标识（stable / staging / dev）
APP_RELEASE=stable

# ─── ⚠️ 主人铁律自检（部署前必须确认） ───────────────
# [ ] POSTGRES_PASSWORD 已替换为强密码
# [ ] LINGYAO_JWT_SECRET 留空或已同步云端值
# [ ] APP_VERSION 与 application.yml app.version 一致
# [ ] POSTGRES_DB 与 application-staging.yml / application-private.yml 一致
# [ ] POSTGRES_BIND 云端环境已改为 0.0.0.0 或 127.0.0.1（按安全策略）
# [ ] BACKEND_BIND 云端环境已改为 0.0.0.0（让 nginx 反代访问）