# ============================================
# 凌瑶智数 · 主框架配置
# ============================================

server:
  port: 9091
  servlet:
    context-path: /
  error:
    include-message: always

spring:
  application:
    name: lingyao-platform

  profiles:
    active: dev

  # ---------- 默认（生产）配置 ----------
  datasource:
    url: jdbc:postgresql://localhost:5432/lingyao
    username: lingyao
    password: ${LINGYAO_DB_PASSWORD:}
    driver-class-name: org.postgresql.Driver

  h2:
    console:
      enabled: false

  jpa:
    hibernate:
      ddl-auto: update
    database-platform: org.hibernate.dialect.PostgreSQLDialect
    show-sql: false
    properties:
      hibernate.session_factory.statement_inspector: com.lingyao.platform.security.TenantStatementInspector

# ---------- 业务配置（所有 profile 共享）----------
app:
  version: 2.0.14
  release: ${APP_RELEASE:stable}
  build-time: ${APP_BUILD_TIME:}
  git-commit: ${APP_GIT_COMMIT:dev}
  jwt:
    secret: ${LINGYAO_JWT_SECRET:}
    expiration-seconds: 86400

lingyao:
  jwt:
    secret: ${LINGYAO_JWT_SECRET:}
    expiration-hours: 24
    issuer: lingyao-platform

  # V2.0.5 R-7: 发布管理配置
  release:
    # Staging 机器 SSH 连接（同机自调用：ubuntu@127.0.0.1）
    staging:
      ssh-host: ${LINGYAO_STAGING_SSH_HOST:127.0.0.1}
      ssh-port: ${LINGYAO_STAGING_SSH_PORT:22}
      ssh-user: ${LINGYAO_STAGING_SSH_USER:ubuntu}
      ssh-key-path: ${LINGYAO_STAGING_SSH_KEY:/home/ubuntu/.ssh/release_staging_key}
      deploy-script: /opt/lingyao/staging/deploy-staging.sh
    # Prod 部署脚本（本地调用，无需 SSH）
    prod:
      deploy-script: /opt/lingyao/deploy-prod.sh
    # 飞书/钉钉 Webhook 推送（可选，启用后在部署完成后推消息）
    webhook-url: ${LINGYAO_RELEASE_WEBHOOK_URL:}
    webhook-enabled: ${LINGYAO_RELEASE_WEBHOOK_ENABLED:false}

  # V2.0.11 D-1：子任务路由（取代 data.sql 硬编码 base_url）
  # 环境变量覆盖：LINGYAO_SUBTASK_<PRODUCT>_BASE_URL / HEALTH_URL / ENTRY_PATH
  subtask:
    routes:
      geo:
        base-url: ${LINGYAO_SUBTASK_GEO_BASE_URL:http://localhost:5180/#/auth/lingyao/sso-callback}
        health-url: ${LINGYAO_SUBTASK_GEO_HEALTH_URL:http://127.0.0.1:8090/api/health}
        entry-path: ${LINGYAO_SUBTASK_GEO_ENTRY_PATH:/subtask/geo}
      hpd:
        base-url: ${LINGYAO_SUBTASK_HPD_BASE_URL:http://localhost:3100}
        health-url: ${LINGYAO_SUBTASK_HPD_HEALTH_URL:http://localhost:8100/api/health}
        entry-path: ${LINGYAO_SUBTASK_HPD_ENTRY_PATH:/subtask/hpd}
      aidd:
        base-url: ${LINGYAO_SUBTASK_AIDD_BASE_URL:http://localhost:13000/sso-callback.html}
        health-url: ${LINGYAO_SUBTASK_AIDD_HEALTH_URL:http://localhost:18080/api/_diag/version}
        entry-path: ${LINGYAO_SUBTASK_AIDD_ENTRY_PATH:/subtask/aidd}
      dinfo:
        base-url: ${LINGYAO_SUBTASK_DINFO_BASE_URL:http://localhost:5181/auth/lingyao/callback}
        health-url: ${LINGYAO_SUBTASK_DINFO_HEALTH_URL:http://localhost:8281/api/_diag/version}
        entry-path: ${LINGYAO_SUBTASK_DINFO_ENTRY_PATH:/subtask/dinfo}
      porm:
        base-url: ${LINGYAO_SUBTASK_PORM_BASE_URL:http://localhost:3190}
        health-url: ${LINGYAO_SUBTASK_PORM_HEALTH_URL:http://localhost:8280/api/_diag/version}
        entry-path: ${LINGYAO_SUBTASK_PORM_ENTRY_PATH:/subtask/porm}

sso:
  protocol-version: "1.0"
  jwt:
    secret: ${LINGYAO_JWT_SECRET:}
    token-ttl-seconds: 7200

# ---------- Dev 配置（H2 + H2 Console + DDL）----------

# ---------- Dev 配置（H2 + H2 Console + DDL）----------
---
spring:
  config:
    activate:
      on-profile: dev

  datasource:
    url: jdbc:h2:mem:lingyao;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
    username: sa
    password:
    driver-class-name: org.h2.Driver

  h2:
    console:
      enabled: true
      path: /h2-console
      settings:
        web-allow-others: false

  jpa:
    hibernate:
      ddl-auto: create-drop
    database-platform: org.hibernate.dialect.H2Dialect
    defer-datasource-initialization: true
    show-sql: false
    properties:
      hibernate.session_factory.statement_inspector: com.lingyao.platform.security.TenantStatementInspector

  sql:
    init:
      mode: always

logging:
  level:
    root: INFO
    com.lingyao.platform: INFO

